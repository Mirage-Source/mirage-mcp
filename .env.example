# Copy to .env and fill in. Never commit the real .env.

# Salts the HMAC-SHA256 hash used to anonymize connecting IPs in
# data/sessions.jsonl (see mirage_mcp/identity.py). Without this set, IPs
# simply aren't hashed or logged at all -- capture.record_event still runs,
# ip_hash/country just come through as null. Generate with:
#   openssl rand -hex 32
IP_SALT=
